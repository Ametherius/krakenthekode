{
    "version": 2,
    "builds": [
        {
            "src": "api/submit-quote.js",
            "use": "@vercel/node"
        },
        {
            "src": "*.html",
            "use": "@vercel/static"
        },
        {
            "src": "*.css",
            "use": "@vercel/static"
        },
        {
            "src": "images/*",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/api/submit-quote",
            "dest": "/api/submit-quote.js",
            "methods": ["POST"],
            "headers": {
                "Content-Type": "text/html"
            }
        },
        {
            "src": "/(.*)",
            "dest": "/$1"
        }
    ]
} 